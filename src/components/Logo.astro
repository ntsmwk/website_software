---
import logo from "../../public/logo.svg?raw";
---

<span class="logo block w-[120px] sm:w-[140px] md:w-[160px] lg:w-[180px]" role="img" aria-label="Weißenbek Software" set:html={logo} />

<style>
  .logo > :global(svg) {
    width: 100%;
    height: auto;
  }
  /* wordmark paths ship without a fill; the spark keeps its own */
  .logo :global(svg path:not([fill])) {
    fill: currentColor;
  }
</style>
