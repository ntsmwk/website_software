---
const {
  title,
  img,
  desc,
  url,
  badge,
  role,
  tags,
} = Astro.props;
import { Image } from "astro:assets";

// plate is 104px high; serve 1x and up to 2x of that, never larger than the source
const plateHeight = Math.min(104, img.height);
const maxDensity = Math.floor(Math.min(2, img.height / plateHeight) * 10) / 10;
const densities = maxDensity > 1 ? [1, maxDensity] : [1];
---

<div class="rounded bg-base-100 transition-colors hover:bg-base-200">
  <a href={url}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <div class="shrink-0 w-full md:w-[13rem] h-[6.5rem] rounded border border-base-300 bg-white p-4 flex items-center justify-center">
            <Image
              src={img}
              height={plateHeight}
              densities={densities}
              alt={title}
              class="h-full w-auto max-w-full object-contain"
            />
          </div>
        )
      }
      <div class="grow w-full">
        <h2 class="text-xl">
          {title}
          {badge && <span class="badge badge-secondary mx-2 font-sans">{badge}</span>}
        </h2>
        {role && <p class="text-lg font-normal text-base-content/70">{role}</p>}
        <p class="py-1">{desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <span class="badge badge-outline font-mono text-base-content/80">{tag}</span>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
