---
const {
  title,
  img,
  desc,
  url,
  badge,
  role,
  tags,
  target = "_blank",
} = Astro.props;
import { Image } from "astro:assets";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-glow-sm transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <div class="shrink-0 w-full md:w-[13rem] rounded-lg bg-white p-4 flex items-center justify-center">
            <Image
              src={img}
              width={750}
              height={422}
              format="webp"
              alt={title}
              class="max-w-full h-auto"
            />
          </div>
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p>
          {role && <p class="text-lg font-thin">{role}</p>}
          <p class="py-1 text-1xl">{desc}</p>
          <div class="card-actions justify-end">
            {
              tags &&
                tags.map((tag) => (
                  <span class="badge badge-outline font-mono">{tag}</span>
                ))
            }
          </div>
        </p>
      </div>
    </div>
  </a>
</div>
