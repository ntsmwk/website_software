---
import { getLocale, alternatePath } from "../lib/i18n";

const { class: className = "" } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const target = locale === "en" ? "de" : "en";
const href = alternatePath(Astro.url.pathname, target);
---

<a
  href={href}
  aria-label={target === "en" ? "EN: Switch to English" : "DE: Auf Deutsch wechseln"}
  title={target === "en" ? "Switch to English" : "Auf Deutsch wechseln"}
  class={`btn btn-ghost btn-square font-mono text-sm ${className}`}
>
  {target.toUpperCase()}
</a>
