---
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  aria-label="Toggle color theme"
  title="Toggle color theme"
  class={`theme-toggle btn btn-ghost btn-square ${className}`}
>
  <label class="swap swap-rotate">
    <input type="checkbox" class="theme-toggle-checkbox" />
    <svg
      class="swap-off h-5 w-5 fill-current"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      ><path
        d="M5.64 17l-.71.71a1 1 0 101.41 1.41l.71-.71A1 1 0 105.64 17zM5 12a1 1 0 00-1-1H3a1 1 0 000 2h1a1 1 0 001-1zm7-7a1 1 0 001-1V3a1 1 0 00-2 0v1a1 1 0 001 1zm6.36 2.64a1 1 0 00.7-.29l.71-.71a1 1 0 10-1.41-1.41l-.71.71a1 1 0 000 1.41 1 1 0 00.71.29zm-1.41 12.02l.71.71a1 1 0 101.41-1.41l-.71-.71a1 1 0 10-1.41 1.41zM21 11h-1a1 1 0 000 2h1a1 1 0 000-2zM12 6a6 6 0 106 6 6 6 0 00-6-6zm0 10a4 4 0 114-4 4 4 0 01-4 4zm-6.36-2.64a1 1 0 00-1.41 0l-.71.71A1 1 0 005.64 17l.71-.71a1 1 0 000-1.41zM12 19a1 1 0 00-1 1v1a1 1 0 002 0v-1a1 1 0 00-1-1z"
      ></path></svg
    >
    <svg
      class="swap-on h-5 w-5 fill-current"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      ><path
        d="M21.64 13a1 1 0 00-1.05-.14 8.05 8.05 0 01-3.37.73 8.15 8.15 0 01-8.14-8.1 8.59 8.59 0 01.25-2A1 1 0 008 2.36a10.14 10.14 0 1014 11.69 1 1 0 00-.36-1.05z"
      ></path></svg
    >
  </label>
</button>

<script>
  function initThemeToggle() {
    const checkboxes = document.querySelectorAll<HTMLInputElement>(
      ".theme-toggle-checkbox",
    );

    const isLight = document.documentElement.dataset.theme === "light";
    checkboxes.forEach((checkbox) => {
      checkbox.checked = isLight;
      checkbox.addEventListener("change", () => {
        const next = checkbox.checked ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        checkboxes.forEach((cb) => {
          if (cb !== checkbox) cb.checked = checkbox.checked;
        });
      });
    });
  }

  initThemeToggle();
  document.addEventListener("astro:after-swap", initThemeToggle);
</script>
