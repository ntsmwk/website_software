---
import BaseHead from "../components/BaseHead.astro";
import TopNav from "../components/TopNav.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";
import { getLocale, useTranslations } from "../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  image,
  title,
  pageTitle,
  description = SITE_DESCRIPTION[locale],
  ogType,
} = Astro.props;

const fullTitle =
  title ?? (pageTitle ? `${pageTitle} · ${SITE_TITLE}` : `${SITE_TITLE} · ${t("site.tagline")}`);
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content">
    <TopNav />
    <main class="mx-auto w-full max-w-[1040px] flex-1 px-5 py-10 md:px-9">
      <slot />
    </main>
    <Footer />
  </body>
</html>
