---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import RoundIcon from "../components/RoundIcon.astro";
import { projects, featuredProjectIds } from "../data/projects";
import { technologyCategories, coreTechnologyNames } from "../data/technologies";
import { getLocale, useTranslations, localizedHref } from "../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const heroCopy = {
  de: {
    bioHtml:
      "Selbstständiger <strong>Software Architekt</strong> und <strong>Senior Software Engineer</strong> im Web-Bereich. Seit mehr als 10 Jahren beschäftige ich mich damit, komplexe Geschäftsprozesse zu konzeptionieren, technisch umzusetzen und langfristig zu betreuen. Meine Kern-Kompetenz liegt vor allem in der Kombination von Technik, Wirtschaft und Team.",
    philosophyHtml:
      "Meine Grundphilosophie im Leben wie auch im Beruf ist klassisch oberösterreichisch &rdquo;Geht ned, gibts ned!&rdquo;.",
  },
  en: {
    bioHtml:
      "Independent <strong>Software Architect</strong> and <strong>Senior Software Engineer</strong> specializing in web technologies. For more than 10 years, I&rsquo;ve been designing complex business processes, implementing them technically, and maintaining them over the long term. My core strength lies in combining technology, business, and team.",
    philosophyHtml:
      "My guiding philosophy, in life as in work, is classic Upper Austrian: &rdquo;Geht ned, gibts ned!&rdquo; &mdash; roughly, &ldquo;there&rsquo;s no such thing as can&rsquo;t.&rdquo;",
  },
}[locale];

const featuredProjects = featuredProjectIds
  .map((id) => projects.find((project) => project.id === id))
  .filter((project): project is (typeof projects)[number] => Boolean(project));

const allTechItems = technologyCategories.flatMap((category) => category.items);
const coreTechnologies = coreTechnologyNames
  .map((name) => allTechItems.find((item) => item.name === name))
  .filter((item): item is (typeof allTechItems)[number] => Boolean(item));
---

<BaseLayout sideBarActiveItemID="home">
  <div class="mt-5">
    <h1 class="text-5xl font-bold">DI Markus Weißenbek</h1>
    <p class="text-3xl py-3 font-bold">{t("site.tagline")}</p>
    <div class="py-2">
      <div class="text-lg">
        <p class="py-2" set:html={heroCopy.bioHtml} />
        <div class="divider my-2"></div>
        <p class="py-2" set:html={heroCopy.philosophyHtml} />
      </div>
    </div>
  </div>

  <div class="mt-12">
    <h2 class="text-3xl w-full font-bold mb-2">{t("home.latestProjects")}</h2>
  </div>

  {
    featuredProjects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title[locale]}
          img={project.image}
          desc={project.description[locale]}
          url={project.url}
        />
        {index < featuredProjects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
  <div class="flex justify-end mt-4">
    <a
      class="btn btn-lg btn-primary shadow-glow-sm"
      href={localizedHref("/projects", locale)}>{t("home.allProjects")}</a
    >
  </div>

  <div class="mt-12">
    <h2 class="text-3xl w-full font-bold mb-2 mt-12">{t("home.coreTechnologies")}</h2>
  </div>

  <div class="flex flex-row flex-wrap">
    {
      coreTechnologies.map((tech) => (
        <RoundIcon name={tech.name} img={tech.img} format={tech.format} url={tech.url} />
      ))
    }
  </div>

  <div class="flex justify-end mt-4">
    <a
      class="btn btn-lg btn-primary shadow-glow-sm"
      href={localizedHref("/technologies", locale)}>{t("home.allTechnologies")}</a
    >
  </div>

</BaseLayout>
