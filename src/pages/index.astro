---
import BaseLayout from "../layouts/BaseLayout.astro";
import { home } from "../data/home";
import { services } from "../data/services";
import { clients } from "../data/clients";
import { projects, featuredProjectIds } from "../data/projects";
import { coreTechnologyNames } from "../data/technologies";
import { getLocale, useTranslations, localizedHref, localize } from "../lib/i18n";
import type { LocalizedText } from "../data/projects";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const l = (field: LocalizedText) => localize(field, locale);

const featuredProjects = featuredProjectIds
  .map((id) => projects.find((project) => project.id === id))
  .filter((project): project is (typeof projects)[number] => Boolean(project));

const detailHref = (id: string) => localizedHref(`/projects/${id}/`, locale);

const mail = "mailto:markus@weissenbek.at";
const linkedIn = "https://www.linkedin.com/in/markus-wei%C3%9Fenbek-322060157";
const eyebrowClass = "mb-4 font-mono text-xs uppercase tracking-widest text-base-content/60";
---

<BaseLayout>
  <div class="space-y-20 md:space-y-24">
    <section>
      <p class={eyebrowClass}>{l(home.eyebrow)}</p>
      <h1 class="max-w-[20ch] text-4xl leading-[1.12] md:text-5xl" set:html={l(home.heroHtml)} />
      <p class="mt-6 max-w-[56ch] text-lg text-base-content/80">{l(home.intro)}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={mail}>{t("nav.cta")}</a>
        <a class="btn btn-outline" href={localizedHref("/projects", locale)}>{l(home.seeProjects)}</a>
      </div>
    </section>

    <section>
      <p class={eyebrowClass}>{l(home.trustedBy)}</p>
      <div class="flex flex-wrap items-center gap-x-10 gap-y-5">
        {
          clients.map((client) => {
            return (
              <a
                href={detailHref(client.projectId)}
                title={client.name}
                class="grayscale opacity-70 transition hover:opacity-100 hover:grayscale-0"
              >
                <img src={client.logo} alt={client.name} class="h-7 w-auto md:h-8" loading="lazy" />
              </a>
            );
          })
        }
      </div>
    </section>

    <section>
      <h2 class="mb-6 text-3xl">{l(home.servicesTitle)}</h2>
      <div class="grid gap-8 md:grid-cols-3">
        {
          services.map((service) => (
            <div>
              <h3 class="font-semibold">{l(service.title)}</h3>
              <p class="mt-2 text-base-content/75">{l(service.description)}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-10 font-mono text-sm text-base-content/70">
        {l(home.stackLabel)} {coreTechnologyNames.join(" · ")}
        <a class="link link-primary ml-2 whitespace-nowrap" href={localizedHref("/technologies", locale)}
          >{l(home.allTechnologies)}</a
        >
      </p>
    </section>

    <section>
      <h2 class="mb-6 text-3xl">{l(home.projectsTitle)}</h2>
      {
        featuredProjects.map((project) => (
          <article class="grid gap-6 border-t border-base-300 py-6 md:grid-cols-[180px_1fr]">
            <div>
              <h3 class="font-semibold">
                <a class="link-hover" href={detailHref(project.id)}>{l(project.title)}</a>
              </h3>
              <p class="text-sm text-base-content/60">{l(project.badge)}</p>
            </div>
            <div class="space-y-2">
              <p>{l(project.description)}</p>
              <p class="text-sm">
                {l(home.roleLabel)} {l(project.role)}
              </p>
              {project.outcome && (
                <p class="text-sm">
                  {l(home.outcomeLabel)} {l(project.outcome)}
                </p>
              )}
              <p class="font-mono text-xs text-base-content/60">{project.tags.join(" · ")}</p>
            </div>
          </article>
        ))
      }
      <div class="flex justify-end border-t border-base-300 pt-4">
        <a class="link link-primary" href={localizedHref("/projects", locale)}>{l(home.allProjects)}</a>
      </div>
    </section>

    <section>
      <h2 class="mb-6 text-3xl">{l(home.aboutTitle)}</h2>
      <div class="grid items-start gap-8 md:grid-cols-[160px_1fr]">
        <img
          src="/profile.webp"
          alt="Markus Weißenbek"
          width="160"
          height="160"
          class="h-auto w-[160px] rounded border border-base-300"
        />
        <div class="space-y-4">
          <p set:html={l(home.bioHtml)} />
          <blockquote class="border-l-2 border-primary pl-4 italic text-base-content/80" set:html={l(home.philosophyHtml)} />
          <p>
            <a class="link link-primary" href={localizedHref("/cv", locale)}>{l(home.seeCv)}</a>
          </p>
        </div>
      </div>
    </section>

    <section id="kontakt">
      <h2 class="mb-6 text-3xl">{l(home.contactTitle)}</h2>
      <p class="max-w-[56ch] text-lg">{l(home.contactText)}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a class="btn btn-primary" href={mail}>{t("nav.cta")}</a>
        <a class="link link-primary" href={mail}>markus@weissenbek.at</a>
        <a class="link-hover link" href={linkedIn} target="_blank">LinkedIn</a>
      </div>
    </section>
  </div>
</BaseLayout>
