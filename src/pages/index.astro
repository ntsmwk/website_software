---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import RoundIcon from "../components/RoundIcon.astro";
import { projects, featuredProjectIds } from "../data/projects";
import { technologyCategories, coreTechnologyNames } from "../data/technologies";

const featuredProjects = featuredProjectIds
  .map((id) => projects.find((project) => project.id === id))
  .filter((project): project is (typeof projects)[number] => Boolean(project));

const allTechItems = technologyCategories.flatMap((category) => category.items);
const coreTechnologies = coreTechnologyNames
  .map((name) => allTechItems.find((item) => item.name === name))
  .filter((item): item is (typeof allTechItems)[number] => Boolean(item));
---

<BaseLayout sideBarActiveItemID="home">
  <div class="mt-5">
    <div class="text-5xl font-bold">DI Markus Weißenbek</div>
    <div class="text-3xl py-3 font-bold">
      Software Architekt | Senior Software Engineer
    </div>
    <div class="py-2">
      <text class="text-lg">
        <p class="text-justify py-2">
          Selbstständiger <strong>Software Architekt</strong> und <strong
            >Senior Software Engineer
          </strong> im Web-Bereich. Seit mehr als 10 Jahren beschäftige ich mich
          damit, komplexe Geschäftsprozesse zu konzeptionieren, technisch umzusetzen
          und langfristig zu betreuen. Meine Kern-Kompetenz liegt vor allem in der
          Kombination von Technik, Wirtschaft und Team.

          <div class="divider my-2"></div>
          Meine Grundphilosophie im Leben wie auch im Beruf ist klassisch oberösterreichisch
          ”Geht ned, gibts ned!”.
        </p>
      </text>
    </div>
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-2">Letzten Projekte</div>
  </div>

  {
    featuredProjects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title.de}
          img={project.image}
          desc={project.description.de}
          url={project.url}
        />
        {index < featuredProjects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
  <div class="flex justify-end mt-4">
    <a
      class="btn btn-lg btn-primary shadow-glow-sm"
      href="/projects">Alle Projekte</a
    >
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-2 mt-12">Kern-Technologien</div>
  </div>

  <div class="flex flex-row flex-wrap">
    {
      coreTechnologies.map((tech) => (
        <RoundIcon name={tech.name} img={tech.img} format={tech.format} url={tech.url} />
      ))
    }
  </div>

  <div class="flex justify-end mt-4">
    <a
      class="btn btn-lg btn-primary shadow-glow-sm"
      href="/technologies">Alle Technologien</a
    >
  </div>

  <!-- <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  } -->
</BaseLayout>
