---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cv } from "../data/cv";
import { projects } from "../data/projects";
import { getLocale, useTranslations, localizedHref, localize } from "../lib/i18n";
import { formatRange } from "../lib/dates";
import type { LocalizedText } from "../data/projects";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const l = (field: LocalizedText) => localize(field, locale);

const linkedProjects = (ids: string[]) =>
  ids.map((id) => projects.find((project) => project.id === id)).filter((p): p is (typeof projects)[number] => Boolean(p));
---

<BaseLayout pageTitle={t("cv.title")} description={l(cv.summary[0])}>
  <div class="max-w-[760px]">
    <h1 class="text-4xl leading-[1.12] md:text-5xl">{t("cv.title")}</h1>
    <p class="mt-6 text-lg">{cv.summary.map(l).join(" ")}</p>

    <section class="mt-16">
      <h2 class="mb-2 text-3xl">{t("cv.experience")}</h2>
      {
        cv.experience.map((entry) => (
          <article class="grid gap-2 border-t border-base-300 py-6 md:grid-cols-[170px_1fr] md:gap-6">
            <p class="font-mono text-sm text-base-content/70 md:whitespace-nowrap">{formatRange(entry.from, entry.to, locale)}</p>
            <div>
              <p>
                <span class="font-semibold">{l(entry.employer)}</span>
                <span class="text-base-content/70"> · {l(entry.location)}</span>
              </p>
              <p>{l(entry.role)}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/80">
                {entry.bullets.map((bullet) => (
                  <li>{l(bullet)}</li>
                ))}
              </ul>
              {entry.projectIds && (
                <p class="mt-2 text-sm">
                  {t("cv.projects")}{" "}
                  {linkedProjects(entry.projectIds).map((project, i) => (
                    <>
                      {i > 0 && " · "}
                      <a class="link link-primary" href={localizedHref(`/projects/${project.id}/`, locale)}>
                        {l(project.title)}
                      </a>
                    </>
                  ))}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </section>

    <section class="mt-16">
      <h2 class="mb-2 text-3xl">{t("cv.education")}</h2>
      {
        cv.education.map((entry) => (
          <article class="grid gap-2 border-t border-base-300 py-6 md:grid-cols-[170px_1fr] md:gap-6">
            <p class="font-mono text-sm text-base-content/70 md:whitespace-nowrap">{formatRange(entry.from, entry.to, locale)}</p>
            <div>
              <p>
                <span class="font-semibold">{l(entry.institution)}</span>
                <span class="text-base-content/70"> · {l(entry.location)}</span>
              </p>
              <p>{l(entry.degree)}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-base-content/80">
                {entry.notes.map((note) => (
                  <li>{l(note)}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </section>

    <section class="mt-16">
      <h2 class="mb-6 text-3xl">{t("cv.skills")}</h2>
      <dl class="grid gap-x-6 gap-y-4 border-t border-base-300 pt-6 md:grid-cols-[170px_1fr]">
        {
          cv.skills.map((group) => (
            <>
              <dt class="text-sm text-base-content/70">{l(group.name)}</dt>
              <dd class="font-mono text-sm">{group.items.join(" · ")}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <div class="mt-16 flex flex-wrap items-center gap-4 border-t border-base-300 pt-6">
      <a class="btn btn-primary" href="mailto:markus@weissenbek.at">{t("nav.cta")}</a>
      <a class="link link-primary" href={localizedHref("/projects", locale)}>{t("cv.allProjects")}</a>
    </div>
  </div>
</BaseLayout>
