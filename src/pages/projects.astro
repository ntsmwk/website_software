---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
import { getLocale, useTranslations } from "../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout pageTitle={t("projects.title")}>
  <div>
    <h1 class="text-3xl w-full mb-5">{t("projects.title")}</h1>
  </div>

  {
    projects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title[locale]}
          img={project.image}
          desc={project.description[locale]}
          url={project.url}
          badge={project.badge[locale]}
          role={project.role[locale]}
          tags={project.tags}
        />
        {index < projects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>
