---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Meine Projekte</div>
  </div>

  {
    projects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title.de}
          img={project.image}
          desc={project.description.de}
          url={project.url}
          badge={project.badge.de}
          role={project.role.de}
          tags={project.tags}
        />
        {index < projects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>
